{
  "manifest_version": 3,
  "name": "Rometto LanguageTool",
  "version": "1.5",
  "description": "Умная проверка орфографии и пунктуации (LanguageTool + Яндекс.Спеллер)",
  "permissions": ["activeTab"],
  "host_permissions": [
    "<all_urls>",
    "https://api.languagetool.org/*",
    "https://speller.yandex.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "Rometto_icon.png",
    "32": "Rometto_icon.png",
    "48": "Rometto_icon.png",
    "128": "Rometto_icon.png"
  },
  "action": {
    "default_icon": "Rometto_icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
